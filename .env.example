# ============================================================
# 环境变量模板：复制为 .env 后填写真实值
#   cp .env.example .env
# ============================================================

# ---- Telegram（必填）----
# 从 @BotFather 创建机器人获取 token
TG_BOT_TOKEN=

# ---- Telegram 账号登录（创建 bot 用，首次需要验证码）----
# api_id / api_hash 从 https://my.telegram.org 获取
TG_API_ID=
TG_API_HASH=
# 用于创建 bot 的账号手机号（+86 开头）与 2FA 密码
TG_PHONE=
TG_2FA_PASSWORD=

# ---- AI 后端（按需填写，对应 ai_agents.yaml 中 enabled 的 agent）----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
SILICONFLOW_API_KEY=

# ---- 飞书（可选）----
# 群机器人 Webhook 地址（飞书群 -> 设置 -> 群机器人 -> 添加自定义机器人）
FEISHU_WEBHOOK_URL=
# App 方式（预留，飞书研究 Agent 定案后使用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
